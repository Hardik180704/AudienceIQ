{
  "name": "audienceiq-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AudienceIQ backend: audience rule evaluation API over synthetic anonymous event data",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx src/db/setup.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
